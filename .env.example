# Hi Daniel! website — build-time configuration. Every NEXT_PUBLIC_* value is
# copied into the public HTML: never put an API key, password or token here.

# Public address of the Hi Daniel! LMS (no trailing slash needed; no query or #).
#   development: http://localhost:52360   (already set in .env.development)
#   staging:     https://<staging LMS host>
#   production:  https://<public LMS host>   (https required; localhost is refused)
# Unset = the LMS is not public yet: LMS buttons lead to the /lms/ page,
# which says so instead of linking anywhere.
NEXT_PUBLIC_LMS_URL=

# Sub-folder the site is served from (GitHub Pages project site: /Hi-Daniel-Website-).
# Set automatically by the GitHub Actions workflow.
NEXT_PUBLIC_BASE_PATH=

# Local test of the exported site only: allow a localhost LMS URL in `npm run build`.
# LMS_URL_ALLOW_LOCAL=1

# Dan Platform (separate system). Public https addresses; unset = no link is shown.
# Real login page, e.g. https://<dan-platform-host>/<login route>. Home is optional (falls back to login).
NEXT_PUBLIC_DAN_PLATFORM_LOGIN_URL=
NEXT_PUBLIC_DAN_PLATFORM_URL=
