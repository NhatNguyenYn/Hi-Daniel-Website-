{
  "$description": "Hi Daniel! design tokens — the single source of truth. Edit this file, then run `node design-system/build.mjs` to regenerate the CSS files. Values written as {name} refer to a colour in `color`.",
  "version": "1.0.0",

  "color": {
    "navy-50": "#eef2fb",
    "navy-100": "#d9e1f5",
    "navy-200": "#b3c3eb",
    "navy-300": "#7f97d6",
    "navy-400": "#4d6bbd",
    "navy-500": "#2b4ba3",
    "navy-600": "#1b3889",
    "navy-700": "#142d70",
    "navy-800": "#0e2460",
    "navy-900": "#0a1a47",
    "navy-950": "#060f2c",

    "flame-50": "#fff4ec",
    "flame-100": "#ffe3cf",
    "flame-200": "#ffc49c",
    "flame-300": "#ff9f63",
    "flame-400": "#ff8236",
    "flame-500": "#ff6a13",
    "flame-600": "#eb5200",
    "flame-700": "#c24100",

    "sky-brand": "#3d8bff",
    "mint-brand": "#1fc8a0",
    "sun-brand": "#ffbf2e",
    "violet-brand": "#8b5cf6",

    "paper": "#f6f7fb",
    "ink": "#0b1433",
    "white": "#ffffff"
  },

  "semantic": {
    "light": {
      "canvas": "{paper}",
      "surface": "{white}",
      "surface-muted": "{navy-50}",
      "line": "rgb(10 26 71 / 0.1)",
      "line-strong": "rgb(10 26 71 / 0.2)",
      "fg": "{ink}",
      "fg-muted": "rgb(10 26 71 / 0.65)",
      "fg-subtle": "rgb(10 26 71 / 0.45)",
      "primary": "{flame-500}",
      "primary-hover": "{flame-600}",
      "on-primary": "{white}",
      "secondary": "{navy-800}",
      "secondary-hover": "{navy-700}",
      "on-secondary": "{white}",
      "link": "{flame-700}",
      "focus": "{flame-500}",
      "success": "#0b7d62",
      "success-soft": "rgb(31 200 160 / 0.14)",
      "warning": "#a86400",
      "warning-soft": "rgb(255 191 46 / 0.2)",
      "danger": "#d4183d",
      "danger-soft": "rgb(255 59 92 / 0.12)",
      "info": "#2563eb",
      "info-soft": "rgb(61 139 255 / 0.12)"
    },
    "dark": {
      "canvas": "{navy-950}",
      "surface": "{navy-900}",
      "surface-muted": "rgb(255 255 255 / 0.06)",
      "line": "rgb(255 255 255 / 0.1)",
      "line-strong": "rgb(255 255 255 / 0.2)",
      "fg": "{white}",
      "fg-muted": "rgb(255 255 255 / 0.6)",
      "fg-subtle": "rgb(255 255 255 / 0.45)",
      "primary": "{flame-500}",
      "primary-hover": "{flame-400}",
      "on-primary": "{white}",
      "secondary": "{white}",
      "secondary-hover": "{navy-50}",
      "on-secondary": "{navy-900}",
      "link": "{flame-400}",
      "focus": "{flame-400}",
      "success": "{mint-brand}",
      "success-soft": "rgb(31 200 160 / 0.16)",
      "warning": "{sun-brand}",
      "warning-soft": "rgb(255 191 46 / 0.16)",
      "danger": "#ff7088",
      "danger-soft": "rgb(255 59 92 / 0.18)",
      "info": "#7fb0ff",
      "info-soft": "rgb(61 139 255 / 0.18)"
    }
  },

  "product": {
    "lms": "{flame-500}",
    "live": "{sky-brand}",
    "studio": "{violet-brand}",
    "insights": "{mint-brand}"
  },

  "gradient": {
    "cta": "linear-gradient(135deg, #ff6a13 0%, #ff8236 45%, #ffbf2e 100%)",
    "text": "linear-gradient(100deg, #ff6a13 0%, #ffbf2e 45%, #ff8236 100%)",
    "progress": "linear-gradient(90deg, #ff6a13, #ffbf2e, #ff8236)"
  },

  "font": {
    "sans": "\"Be Vietnam Pro\", ui-sans-serif, system-ui, sans-serif",
    "weights": [400, 500, 600, 700, 800]
  },

  "text": {
    "display": { "size": "clamp(2.5rem, 7vw, 5.75rem)", "lineHeight": "1.02", "letterSpacing": "-0.035em", "weight": "800" },
    "headline": { "size": "clamp(2rem, 4.8vw, 4rem)", "lineHeight": "1.06", "letterSpacing": "-0.03em", "weight": "800" },
    "title": { "size": "1.375rem", "lineHeight": "1.25", "letterSpacing": "-0.015em", "weight": "700" },
    "body-lg": { "size": "1.0625rem", "lineHeight": "1.65", "letterSpacing": "0", "weight": "400" },
    "body": { "size": "0.9375rem", "lineHeight": "1.6", "letterSpacing": "0", "weight": "400" },
    "caption": { "size": "0.8125rem", "lineHeight": "1.45", "letterSpacing": "0", "weight": "500" },
    "eyebrow": { "size": "0.875rem", "lineHeight": "1.2", "letterSpacing": "0.18em", "weight": "600" }
  },

  "radius": {
    "control": "12px",
    "chip": "16px",
    "window": "18px",
    "quote": "24px",
    "card": "28px",
    "pill": "9999px"
  },

  "shadow": {
    "cta": "0 10px 30px -10px rgb(255 106 19 / 0.8)",
    "cta-hover": "0 16px 40px -12px rgb(255 106 19 / 0.9)",
    "card-hover": "0 30px 70px -30px rgb(10 26 71 / 0.35)",
    "float": "0 20px 50px -15px rgb(10 26 71 / 0.35)",
    "window": "0 40px 120px -30px rgb(10 26 71 / 0.45)"
  },

  "ease": {
    "out-expo": "cubic-bezier(0.16, 1, 0.3, 1)"
  },

  "duration": {
    "fast": "200ms",
    "base": "300ms",
    "slow": "600ms",
    "reveal": "1200ms"
  }
}
